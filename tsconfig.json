{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts", "**/*.mjs"],
  "exclude": ["node_modules", "dist", ".opencode"]
}
