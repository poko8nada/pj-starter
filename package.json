{
  "name": "project-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm typecheck:product && pnpm typecheck:opencode && pnpm typecheck:commandcode",
    "typecheck:product": "tsc --noEmit",
    "typecheck:opencode": "tsc -p .opencode/tsconfig.json --noEmit",
    "typecheck:commandcode": "tsc -p .commandcode/tsconfig.json --noEmit",
    "typecheck:staged": "node scripts/typecheck-staged.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "lefthook": "^1.11.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "6.0.3",
    "vitest": "^4.0.18"
  }
}
