// .opencode 配下（プラグイン等）専用の tsconfig。ルートの tsconfig とは責務が別
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["plugin/**/*.ts", "lib/**/*.ts"]
}
